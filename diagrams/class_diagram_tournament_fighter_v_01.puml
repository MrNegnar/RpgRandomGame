@startuml Class diagram of Tournament Fighter

'===============Interfaces=================

interface GameInterface {
  +createPlayer(): Player
  +createEnemy(): Enemy
  +setupTournament(players: List<Player>, enemies: List<Enemy>): void
  +startTournament(participants: List<Character>): void
  +createFight(participants: List<Character>): void
}



'===============Objects=================

object EnemyObject <<object>> {
  Goblin
  Rat
  Skeleton
  Zombie
  Orc
  Troll
  Dragon
}

object Race <<object>> {
  HUMAN
  ELF
  DWARF
  GNOME
  ORC
}

object CharacterClass <<object>> {
  WARRIOR
  ROGUE
  MAGE
  CLERIC
}

'===============Object data=================

object EnemyObjectData <<object.data>> {
  Health
  Attack
  Defense
  evasion
  Speed
}

object RaceData <<object.data>> {
  StrengthBonus
  DexterityBonus
  ConstitutionBonus
  IntelligenceBonus
  WisdomBonus
  CharismaBonus
}

object CharacterClassData <<object.data>> {
  StrengthBonus
  DexterityBonus
  ConstitutionBonus
  IntelligenceBonus
  WisdomBonus
  CharismaBonus
}



'===============abstract classes=================

abstract Character implements CharacterInterface {
  - race: Race
  - class: CharacterClass
  - name: string
  - health: number
  - maxHealth: number
  - currentHitpoints: number
  - speed: number
  - armor: number
  - evasion: number
  - strength: number
  - dexterity: number
  - constitution: number
  - intelligence: number
  - wisdom: number
  - isAlive(): boolean
  + toString(): string
}

'===============concrete classes=================

class Game implements GameInterface {
  -players: List<Player>
  -enemies: List<Enemy>
  +addPlayer(player: Player): void
  +addEnemy(enemy: Enemy): void
  +setupTournament(players: List<Player>, enemies: List<Enemy>): void
  +startTournament(participants: List<Character>): void
  +createFight(participants: List<Character>): void
}

class Player extends Character {
}

class Enemy extends Character {
}

'================Objects=================

Character --> "is a" Race
Character --> "is a" CharacterClass

Enemy --> "is a" EnemyObject

'===============relations=================

Game --> "..*" Character: creates

'==========Object data relations===========

Race --> "contains" RaceData

EnemyObject --> "contains" EnemyObjectData

CharacterClass --> "contains" CharacterClassData

'===============Notes=================

@enduml
