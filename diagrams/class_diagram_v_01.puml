@startuml Class diagram of rpgtournament

'===============Interfaces=================

interface GameInterface {
  +createPlayer(): Player
  +createEnemy(): Enemy
  +setupTournament(players: List<Player>, enemies: List<Enemy>): void
  +startTournament(participants: List<Character>): void
  +startFight(participants: List<Character>): void
}

interface CharacterInterface {
  +equipItem(item: Equipment): void
  +unequipItem(item: Equipment): void
}

'===============Enums=================

enum Gender {
  MALE
  FEMALE
}

enum Alignment {
  LAWFUL_GOOD
  NEUTRAL_GOOD
  CHAOTIC_GOOD
  LAWFUL_NEUTRAL
  TRUE_NEUTRAL
  CHAOTIC_NEUTRAL
  LAWFUL_EVIL
  NEUTRAL_EVIL
  CHAOTIC_EVIL
}

'===============Objects=================

object EnemyType <<object>> {
  Goblin
  Rat
  Skeleton
  Zombie
  Orc
  Troll
  Dragon
}

object Races <<object>> {
  HUMAN
  ELF
  DWARF
  GNOME
  ORC
}

object CharacterClass <<object>> {
  WARRIOR
  MAGE
  CLERIC
}

'===============Object data=================

object EnemyTypeData <<object.data>> {
  Health
  Attack
  Defense
  Speed
}

object RaceData <<object.data>> {
  StrengthBonus
  DexterityBonus
  ConstitutionBonus
  IntelligenceBonus
  WisdomBonus
  CharismaBonus
}

object CharacterClassData <<object.data>> {
  StrengthBonus
  IntelligenceBonus
  WisdomBonus
}

'===============abstract classes=================

abstract Character implements CharacterInterface {
  - race: Race
  - class: CharacterClass
  - name: string
  - health: number
  - maxHealth: number
  - currentHitPoints: number
  - speed: number
  - armor: number
  - strength: number
  - dexterity: number
  - constitution: number
  - intelligence: number
  - wisdom: number
  - charisma: number
  - alignment: Alignment
  - gender: Gender
  - items: { name: string, description: string }[]
  - equipment: Equipment
  - equipItem(item: Equipment): void
  - unequipItem(item: Equipment): void
  - changeAlignment(alignment: Alignment)
  - isAlive(): boolean
  + toString(): string
}

'===============concrete classes=================

class Game implements GameInterface {
  -players: List<Player>
  -enemies: List<Enemy>
  +setupTournament(players: List<Player>, enemies: List<Enemy>): void
  +startTournament(participants: List<Character>): void
  +startFight(participants: List<Character>): void
}

class Player extends Character {
}

class Enemy extends Character {
}

class CharacterCreation <<module>> {
  + createCharacter(): Character
  - setCharacterName(): string
  - setCharacterRace(): Race
  - setCharacterClass(): CharacterClass
  - setCharacterAttributes(): { strength: number, dexterity: number, constitution: number, intelligence: number, wisdom: number, charisma: number }
  - setCharacterAlignment(): Alignment
  - setCharacterGender()
  - setCharacterStartingMaxHealth(race: Race, stats: { constitution: number }): number
}




'===============Enums=================

Character --> "has a" Alignment
Character --> "has a" Gender

'================Objects=================

Character --> "is a" Races
Character --> "is a"CharacterClass

Enemy --> "is a" EnemyType

'===============types=================


'===============relations=================

Game --> "uses" CharacterCreation
Game --> "1" Player: creates
Game --> "..*" Enemy: creates

'==========Object data relations===========

Races --> "contains" RaceData

EnemyType --> "contains" EnemyTypeData

CharacterClass --> "contains" CharacterClassData

'===============Notes=================



@enduml
