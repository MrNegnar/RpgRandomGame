@startuml player usecases
actor Player

rectangle "Before tournament" {
  usecase "Create Player" as UC1
  usecase "Create Enemy" as UC2
  usecase "Setup Tournament" as UC3
  usecase "Start Tournament" as UC4
  usecase "Start Fight" as UC5
}

rectangle "During tournament" {
  usecase "Equip Item" as UC6
  usecase "Unequip Item" as UC7
}

Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4
Player --> UC5
Player --> UC6
Player --> UC7

@enduml
