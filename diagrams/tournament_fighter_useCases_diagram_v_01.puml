@startuml player usecases
actor Player

left to right direction

rectangle "Before tournament" {
  usecase "Create Player" as UC1
  usecase "Create Enemy" as UC2
  usecase "Setup Tournament" as UC3
  usecase "Start Tournament" as UC4
  usecase "Start Fight" as UC5
}

rectangle "During fight (from module)" {
  usecase "attack" as UC6
  usecase "cast spell: magic missile" as UC7
  usecase "raise defence" as UC8
  usecase "raise evasion" as UC9
  usecase "heal" as UC10
}

Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4
Player --> UC5
Player --> UC6
Player --> UC7
Player --> UC8
Player --> UC9
Player --> UC10

@enduml
